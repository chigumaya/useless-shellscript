lsystem(){
  local iter p i k v y s
  iter=$1
  p=$2
  shift 2
  for i in $@; do
    k=${i%:*}
    v=${i#*:}
    y=$y$k
    s="$s s/$k/${v,,}/g;"
  done
  while test $iter -gt 0; do
    p=$(echo $p | sed "$s y/${y,,}/$y/")
    iter=$((iter-1))
  done
  echo $p | fold -1
}

-(){ ((--i));}
+(){ ((++i));}
[(){ s[++j]="x=$x;y=$y;i=$i"; }
](){ eval ${s[j--]}; }
